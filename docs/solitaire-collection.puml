@startuml
 title Solitaire Collection - Current Game Logic
 skinparam classAttributeIconSize 0
 skinparam shadowing false
 left to right direction

 enum Suit {
   CLUBS
   DIAMONDS
   HEARTS
   SPADES
 }

 class Card {
   - suit: Suit
   - rank: int
   - faceUp: boolean
   + Card(suit: Suit, rank: int)
   + getSuit(): Suit
   + getRank(): int
   + isFaceUp(): boolean
   + setFaceUp(faceUp: boolean): void
   + isRed(): boolean
 }

 class Deck {
   - cards: List<Card>
   - Deck()
   + createStandardDeck(): Deck {static}
   + createSpiderDeck(suitCount: int): Deck {static}
   + shuffle(): void
   + draw(): Card
   + size(): int
 }

 class CardPile {
   - cards: List<Card>
   + peek(): Card
   + size(): int
   + isEmpty(): boolean
   + getCards(): List<Card>
   + addCards(cards: List<Card>): void
   + removeTopCards(count: int): List<Card>
 }

 abstract class SolitaireGame {
   # tableau: List<CardPile>
   - undoHistory: Deque<GameSnapshot>
   - moveCount: int
   + startNewGame(): void
   + getTableau(): List<CardPile>
   # recordMove(): void
   # afterMove(): void
   + moveCards(from: CardPile, to: CardPile, count: int): boolean
   + canMove(from: CardPile, to: CardPile, count: int): boolean {abstract}
   + undo(): boolean
   + getMoveCount(): int
   + isWon(): boolean {abstract}
 }

 class KlondikeGame {
   - drawCount: int
   - stock: CardPile
   - waste: CardPile
   - foundations: List<CardPile>
   + KlondikeGame(drawCount: int)
   + startNewGame(): void
   + getStock(): CardPile
   + getWaste(): CardPile
   + getFoundations(): List<CardPile>
   + drawFromStock(): boolean
   + recycleStock(): boolean
   + canMove(from: CardPile, to: CardPile, count: int): boolean
   + isWon(): boolean
 }

 class SpiderGame {
   - suitCount: int
   - stock: CardPile
   - completedRuns: int
   + SpiderGame(suitCount: int)
   + startNewGame(): void
   + getStock(): CardPile
   + getCompletedRuns(): int
   # afterMove(): void
   - hasCompletedRun(pile: CardPile): boolean
   + dealNextRow(): boolean
   + removeCompletedRuns(): int
   + canMove(from: CardPile, to: CardPile, count: int): boolean
   + isWon(): boolean
 }

 class GameSnapshot <<final>> {
   - GameSnapshot()
   + capture(game: SolitaireGame): GameSnapshot {static}
   + restore(game: SolitaireGame): void
 }

 class Main {
   + main(args: String[]): void {static}
   - sizes(game: SolitaireGame): List<Integer> {static}
   - describe(card: Card): String {static}
   - demonstrateMove(game: SolitaireGame, sources: List<CardPile>, destinations: List<CardPile>): void {static}
 }

 Card --> Suit
 note bottom of GameSnapshot
   No stored state or owning-game reference.
   capture() and restore() throw UnsupportedOperationException.
   undoHistory is owned by SolitaireGame, never populated,
   and cleared by startNewGame(); undo() also throws.
 end note
 Deck *-- "0..*" Card
 CardPile *-- "0..*" Card
 SolitaireGame *-- "7 or 10" CardPile : tableau
 SolitaireGame *-- "0..*" GameSnapshot : undo history
 KlondikeGame --|> SolitaireGame
 SpiderGame --|> SolitaireGame
 KlondikeGame *-- "1" CardPile : stock
 KlondikeGame *-- "1" CardPile : waste
 KlondikeGame *-- "4" CardPile : foundations
 SpiderGame *-- "1" CardPile : stock
 GameSnapshot ..> SolitaireGame : capture / restore parameters
 KlondikeGame ..> Deck : creates
 SpiderGame ..> Deck : creates
 Main ..> KlondikeGame : demonstrates Turn 1
 Main ..> SpiderGame : demonstrates one suit
 note right of SolitaireGame
   Game rules and state only.
   JavaFX views and drag/drop remain separate.
 end note
@enduml
